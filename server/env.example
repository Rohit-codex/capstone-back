# Database Configuration
MONGODB_URI=mongodb://localhost:27017/dastavez
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/dastavez?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-in-production

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password-if-needed
# If using a managed Redis, prefer setting a single URL instead of host/port
# Non-TLS example:
# REDIS_URL=redis://default:password@host:port
# TLS example (recommended for Cloud providers):
# REDIS_URL=rediss://default:password@host:port

# Enable TLS when connecting to providers that require it (e.g., Upstash/Redis Cloud)
# Set to true if using rediss:// or provider mandates TLS
REDIS_TLS=false

# Email Configuration (for OTP)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Google AI Configuration
GOOGLE_AI_API_KEY=your-google-ai-api-key
# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
# LLM provider selection: gemini | groq | openrouter | ollama
LLM_PROVIDER=gemini
# Groq (used when LLM_PROVIDER=groq)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant
# OpenRouter (used when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_REFERRER=http://localhost:3000
OPENROUTER_APP_NAME=dastavezai-local-dev
LLM_HTTP_TIMEOUT_MS=180000
SMART_SCAN_STEP_TIMEOUT_MS=60000
SMART_SCAN_OPTIONAL_TIMEOUT_MS=30000
# Set to true in local dev to use local LLaMA model instead of Gemini
GEMINI_DISABLED=true

# Cloudinary Configuration (for file uploads)
# Set CLOUDINARY_DISABLE=true for local development (files stored in /uploads/files/)
CLOUDINARY_DISABLE=true
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Subscription/Paywall Configuration
# Set SUBSCRIPTION_DISABLE=true for local development (bypass all subscription checks)
SUBSCRIPTION_DISABLE=true

# Razorpay Configuration (for payments)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Server Configuration
PORT=8080
NODE_ENV=development
HTTPS_REDIRECT=false

# Agent / Conversation Configuration
# Number of recent conversation turns to pass as context to intent classifier (default: 5)
AGENT_HISTORY_LIMIT=5
# Whether to auto-generate documents with missing placeholders (default: false - require user to fill)
AGENT_AUTO_FILL_PLACEHOLDERS=false
# Intent classification LLM timeout in milliseconds (default: 15000)
INTENT_LLM_TIMEOUT_MS=15000

# CORS Configuration
# Comma-separated allowlist used by the server (index.js reads CORS_ORIGINS)
# In development you can leave it empty to allow all, or set localhost origins
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

# For production (Cloud Run), set your public domains, e.g.:
# CORS_ORIGINS=https://dastavezai.org,https://www.dastavezai.org

# Optional: legacy single-origin variable used elsewhere
FRONTEND_URL=http://localhost:3000
